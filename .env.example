NODE_ENV=production
JWT_SECRET=replace-with-a-long-random-secret
MONGODB_URI=your-mongodb-connection-string

# Used to build the OAuth redirect URI (must match your deployed URL)
APP_BASE_URL=https://creovah.onrender.com

# 32+ character random string used to encrypt OAuth access tokens at rest
TOKEN_ENCRYPTION_KEY=replace-with-a-long-random-secret

# Facebook/Instagram app credentials (Meta for Developers)
FB_APP_ID=your-facebook-app-id
FB_APP_SECRET=your-facebook-app-secret
# Optional override — defaults to {APP_BASE_URL}/api/connections/facebook/callback
FB_REDIRECT_URI=https://creovah.onrender.com/api/connections/facebook/callback
